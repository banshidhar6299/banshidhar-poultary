# ==============================================================================
# BANSHIDHAR POULTRY (बंशीधर पोल्ट्री) - ENVIRONMENT CONFIGURATION
# ==============================================================================
# ⚠️  PRODUCTION REQUIREMENTS:
#   - ALL variables marked [REQUIRED] must be set in production
#   - JWT_SECRET must be at least 32 characters
#   - CLIENT_URL and SERVER_URL must use HTTPS in production
#   - Wildcard (*) CORS is NOT allowed in production
#   - Never use seed credentials (admin/admin123) in production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173           # [REQUIRED in production] HTTPS URL(s), comma-separated for multiple origins
SERVER_URL=http://localhost:5050           # [REQUIRED in production] HTTPS backend URL
MAX_UPLOAD_MB=25

# ------------------------------------------------------------------------------
# 2. Database Connection (MongoDB Local or MongoDB Atlas)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/banshidhar_poultry  # [REQUIRED in production]

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# [REQUIRED in production] Must be at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Cloud Media Storage (Cloudinary) [ALL REQUIRED in production]
#    Local disk fallback is DISABLED in production.
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=                    # [REQUIRED in production]
CLOUDINARY_API_KEY=                       # [REQUIRED in production]
CLOUDINARY_API_SECRET=                    # [REQUIRED in production]
CLOUDINARY_URL=

# ------------------------------------------------------------------------------
# 5. Email Provider for Password Reset (Brevo / Sendinblue)
# ------------------------------------------------------------------------------
BREVO_API_KEY=                            # [REQUIRED in production]
BREVO_SENDER_EMAIL=noreply@banshidharpoultry.com  # [REQUIRED in production]
BREVO_SENDER_NAME=Banshidhar Poultry

# ------------------------------------------------------------------------------
# 6. AI Poultry Health Doctor (Intelligent 3-Tier Failover + Vision)
# ------------------------------------------------------------------------------
# Provider 1 (Primary): AgentRouter (Claude 3.5 Sonnet / GPT-4o)
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://api.agentrouter.com/v1
AGENTROUTER_MODEL=claude-3-5-sonnet-20241022

# Provider 2 (Secondary Fallback): Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Provider 3 (Tertiary Fallback): Groq (Fast Llama 3.3)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 7. Web Push Notifications (VAPID Keypair)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@banshidharpoultry.com
